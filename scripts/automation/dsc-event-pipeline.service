[Unit]
Description=Decode-first event reconstruction scheduler
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
[Service]
Type=oneshot
User=dsc-data
WorkingDirectory=/home/dsc-data/scripts
ExecStart=/home/dsc-data/scripts/.venv-abi/bin/python /home/dsc-data/scripts/automation/run.py
Nice=10
KillMode=control-group
TimeoutStartSec=infinity
TimeoutStopSec=45
