[Unit]
Description=DSC private extraction monitor
After=network-online.target
Wants=network-online.target
[Service]
User=dsc-web
WorkingDirectory=/home/dsc-web/monitor
Environment=MONITOR_SSH_KEY=/home/dsc-web/.ssh/dsc_monitor
ExecStart=/home/dsc-web/monitor/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 18084
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
[Install]
WantedBy=multi-user.target
