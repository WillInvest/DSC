[Unit]
Description=DSC resumable historical extraction coordinator
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=dsc-data
WorkingDirectory=/home/dsc-data
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/dsc-data/scripts/.venv-abi/bin/python /home/dsc-data/scripts/run.py --contracts /home/dsc-data/contracts/ethereum/pools.csv --profiles /home/dsc-data/data/deployment-profiles --to-block 26259811 --cleanup
Restart=on-failure
RestartSec=60
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
